rules_version = '2';

// PediActual - reglas de acceso.
//
// Antes de este archivo no habia ninguna regla en el repositorio: si el
// proyecto quedo en modo prueba, cualquier usuario autenticado podia leer las
// historias, los telefonos y los pagos de todos los pacientes desde la consola
// del navegador, y el rol se decidia leyendo un campo que el propio usuario
// podia escribir.
//
// Despliegue:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------- utilidades

    function autenticado() {
      return request.auth != null;
    }

    // El rol de confianza es el custom claim. Mientras no esten configurados,
    // se cae al documento de usuario, que ya no es escribible por su dueno.
    function rolClaim() {
      return request.auth.token.role;
    }

    function docUsuario() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function rol() {
      return autenticado()
        ? (rolClaim() != null
            ? rolClaim()
            : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
                ? docUsuario().role
                : 'patient'))
        : '';
    }

    function esSecretaria() { return rol() == 'secretary'; }
    function esDoctora()    { return rol() == 'doctor'; }
    function esPersonal()   { return esSecretaria() || esDoctora(); }

    // El dueno se identifica por su uid, que nadie puede falsificar.
    //
    // La coincidencia por correo se conserva solo para los pacientes que la
    // secretaria cargo antes de que el representante se registrara, pero ahora
    // exige que el correo este verificado. Sin esa condicion bastaba con
    // registrarse usando el correo de otra familia -Firebase no lo comprueba-
    // para leer y modificar la historia clinica de sus hijos.
    function esDueno(datos) {
      return autenticado() && (
        datos.representativeId == request.auth.uid ||
        (datos.email is string
         && datos.email == request.auth.token.email
         && request.auth.token.email_verified == true)
      );
    }

    // Impide que un campo cambie en un update.
    function noCambia(campo) {
      return !(campo in request.resource.data) ||
             request.resource.data[campo] == resource.data[campo];
    }

    // ------------------------------------------------------------- usuarios

    match /users/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esPersonal());

      // Al registrarse solo puede crearse a si mismo y solo como paciente.
      allow create: if autenticado()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'patient'
                    && request.resource.data.uid == uid;

      // Puede editar su perfil pero nunca su propio rol. Esa es la puerta que
      // permitia auto-ascenderse a secretaria.
      allow update: if autenticado()
                    && request.auth.uid == uid
                    && noCambia('role')
                    && noCambia('uid');

      allow delete: if false;
    }

    // ------------------------------------------------------------ pacientes

    match /patients/{patientId} {
      allow read: if esPersonal() || esDueno(resource.data);
      allow create: if esPersonal() ||
                    (autenticado() && request.resource.data.representativeId == request.auth.uid);
      allow update: if esPersonal() || esDueno(resource.data);
      allow delete: if esPersonal();
    }

    // ---------------------------------------------------------------- citas

    match /citas/{citaId} {
      // Leer una cita suelta: el personal siempre, el representante la suya, y
      // cualquiera un documento que no existe. Esa ultima parte no filtra nada
      // -no hay dato que devolver- y es lo que permite que la transaccion de
      // reserva compruebe si el horario esta libre sin abrir la coleccion.
      allow get: if esPersonal() || resource == null || esDueno(resource.data);

      // El representante solo puede listar las suyas: la consulta de "Mis
      // citas" filtra por representativeId, asi que cada documento devuelto
      // cumple la condicion. Una consulta por rango de fechas traeria citas
      // ajenas y Firestore la rechaza entera; por eso la grilla ya no las
      // pide y lee `disponibilidad/{fecha}`, que solo trae las horas tomadas.
      allow list: if esPersonal()
                  || resource.data.representativeId == request.auth.uid;

      allow create: if esPersonal() ||
                    (autenticado() && request.resource.data.representativeId == request.auth.uid);

      // El representante puede cancelar o reprogramar la suya, pero no tocar
      // el estado del pago ni cambiarle el dueno.
      allow update: if esPersonal() ||
                    (esDueno(resource.data)
                     && noCambia('representativeId')
                     && noCambia('pagoEstado')
                     && noCambia('pagoMonto'));

      allow delete: if esPersonal();

      // Indicaciones que la doctora deja para la secretaria.
      match /ordenes/{ordenId} {
        function cita() {
          return get(/databases/$(database)/documents/citas/$(citaId)).data;
        }
        allow read: if esPersonal() || esDueno(cita());
        allow create, delete: if esPersonal();
        // La secretaria resuelve la orden; solo el personal escribe.
        allow update: if esPersonal();
      }
    }

    // ---------------------------------------------------------------- pagos

    match /pagos/{pagoId} {
      allow read: if esPersonal() || esDueno(resource.data);
      allow create: if esPersonal() ||
                    (autenticado() && request.resource.data.representativeId == request.auth.uid);
      // Verificar o rechazar un pago es exclusivo del personal.
      allow update: if esPersonal();
      allow delete: if esPersonal();
    }

    // -------------------------------------------------------------- recetas

    match /prescriptions/{docId} {
      allow read: if esPersonal() || esDueno(resource.data);
      allow write: if esPersonal();
    }

    // ---------------------------------------------------------- recordatorios
    // Los testigos de los enlaces del correo. Cerrados al cliente: si se
    // pudieran listar, cualquiera podria confirmar o cancelar citas ajenas.
    // Solo los escribe y los lee la funcion que manda los recordatorios.
    match /recordatorios/{testigo} {
      allow read, write: if false;
    }

    // -------------------------------------------------- codigos por correo
    // Los codigos de verificacion los escribe y los lee unicamente el
    // servidor. Cerrado por completo al cliente: si se pudieran leer, el
    // codigo dejaria de probar que la persona tiene acceso a ese correo.
    // Ademas solo se guarda el resumen del codigo, no el codigo.
    match /codigos/{docId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------- disponibilidad
    // Que horarios estan tomados cada dia, sin un solo dato del paciente.
    // La escribe unicamente la funcion `sincronizarDisponibilidad` con el SDK
    // de administrador, que no pasa por estas reglas.
    match /disponibilidad/{fecha} {
      allow read: if autenticado();
      allow write: if false;
    }

    // -------------------------------------------------- configuracion clinica

    match /configuracion/{docId} {
      allow read: if autenticado();

      // Solo el personal escribe. Antes cualquier sesion podia reescribir
      // `tasa_bcv`, que es lo que convierte la tarifa en dolares a bolivares:
      // poniendo una tasa de 1 el total a pagar caia de mas de un millon de
      // bolivares a cuarenta, con el comprobante en regla. El respaldo lo
      // refrescan las sesiones del personal, y su escritura ya falla en
      // silencio cuando no hay permiso.
      allow write: if esPersonal();
    }

    // Consulta de grupo de colecciones: la pestana "Indicaciones pendientes"
    // barre todas las subcolecciones `ordenes` de una sola vez. Firestore exige
    // una regla propia para collectionGroup, la del padre no la cubre.
    match /{ruta=**}/ordenes/{ordenId} {
      allow read: if esPersonal();
    }

    // Todo lo que no este declarado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
